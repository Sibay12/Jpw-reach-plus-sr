// --- USER HISTORY API ---
app.get('/api/user-history', async (req, res) => {
    try {
        const { telegramChatId } = req.query;
        if (!telegramChatId) return res.json({ success: false, orders: [] });
        const orders = await OrderModel.find({ telegramChatId: String(telegramChatId) }).sort({ createdAt: -1 });
        res.json({ success: true, orders });
    } catch (e) {
        res.status(500).json({ success: false, orders: [] });
    }
});
